// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  income
  expenses
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  entries    Entry[]
  categories Category[]
  goals      Goal[]

  @@map("user")
}

model Entry {
  id          String    @id @default(uuid())
  title       String
  description String?
  value       Int
  type        EntryType
  date        DateTime
  createdAt   DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  categoryId String   @map("categor_id")
  category   Category @relation(fields: [categoryId], references: [id])

  goalId String? @map("goal_id")
  goal   Goal?   @relation(fields: [goalId], references: [id])

  @@map("entry")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?  @db.Char(6)
  // icon String?  Fezin ira analisar as condições
  createdAt   DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  entries Entry[]

  @@map("category")
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  value       Int
  limitDate   DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  entries Entry[]

  @@map("goal")
}
